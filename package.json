{
  "name": "@local/dsh-web-search-exa",
  "version": "0.2.2-rc.5",
  "description": "Exa-backed search provider for the DSH web seam (ctx.web). Local rebuild of @deepseek-ai/dsh-web-search-exa@0.2.2-rc.1, made self-contained so a link: bundle loads under dsh 0.2.2-rc.5.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmego/dsh-web-search-exa.git"
  },
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "ADAPTATION.md",
    "README.md",
    "README.zh.md",
    "locale",
    "LICENSE"
  ]
}
